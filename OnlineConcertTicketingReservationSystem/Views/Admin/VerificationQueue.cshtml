@model List<OnlineConcertTicketingReservationSystem.Models.ViewModels.VerificationQueueItemViewModel>
@{
    ViewData["Title"] = "Verification Queue";
}

@if (TempData["Message"] is string message) { <div class="alert alert-info">@message</div> }
<div class="page-head"><h1>Payment Verification Queue</h1></div>

@if (Model.Count == 0)
{
    <div class="section-card empty-state">No orders pending verification.</div>
}

@foreach (var item in Model)
{
    <div class="section-card">
            <h5 class="card-title">Order #@item.OrderId - @item.ConcertTitle</h5>
            <h6 class="card-subtitle mb-2 text-white-50">@item.UserName (@item.UserEmail) - submitted @item.CreatedAt.ToString("g")</h6>

            <div class="row">
                <div class="col-md-6">
                    <p><strong>Tickets:</strong> @string.Join(", ", item.SeatLabels)</p>
                    @if (item.AccessorySummaries.Count > 0)
                    {
                        <p><strong>Accessories:</strong> @string.Join(", ", item.AccessorySummaries)</p>
                    }
                    <p><strong>Total:</strong> MMK @item.TotalAmount</p>
                    <p><strong>Transaction Ref:</strong> @item.TransactionRefId</p>
                </div>
                <div class="col-md-6">
                    @if (!string.IsNullOrEmpty(item.PaymentSlipUrl))
                    {
                        <img src="@item.PaymentSlipUrl" alt="Payment slip" class="img-fluid border" style="max-height:250px"/>
                    }
                </div>
            </div>

            <div class="mt-3">
                <form asp-action="VerifyOrder" method="post" class="d-inline">
                    <input type="hidden" name="OrderId" value="@item.OrderId"/>
                    <input type="hidden" name="IsApproved" value="true"/>
                    <button type="submit" class="btn btn-success">Approve</button>
                </form>

                <button type="button" class="btn btn-danger" data-bs-toggle="collapse" data-bs-target="#reject-@item.OrderId">
                    Reject
                </button>

                <div class="collapse mt-2" id="reject-@item.OrderId">
                    <form asp-action="VerifyOrder" method="post">
                        <input type="hidden" name="OrderId" value="@item.OrderId"/>
                        <input type="hidden" name="IsApproved" value="false"/>
                        <div class="mb-2">
                            <input type="text" name="RejectionReason" class="form-control" placeholder="Rejection reason" required/>
                        </div>
                        <button type="submit" class="btn btn-outline-danger">Confirm Rejection</button>
                    </form>
                </div>
            </div>
    </div>
}
