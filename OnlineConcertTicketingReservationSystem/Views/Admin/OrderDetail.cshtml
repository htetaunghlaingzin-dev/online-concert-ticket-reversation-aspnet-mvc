@model OnlineConcertTicketingReservationSystem.Models.ViewModels.OrderDetailViewModel
@{ ViewData["Title"] = $"Order #{Model.Id}"; }
<div class="page-head"><h1>Order #@Model.Id</h1><a asp-action="Orders" class="btn btn-outline-light">Back to orders</a></div>
@if (ViewBag.Message is string message) { <div class="alert alert-info">@message</div> }
<div class="section-card"><partial name="_OrderDetails" model="Model" /></div>
