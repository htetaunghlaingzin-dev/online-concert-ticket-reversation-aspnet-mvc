@using OnlineConcertTicketingReservationSystem.Models.Enums
@model List<OnlineConcertTicketingReservationSystem.Models.ViewModels.OrderSummaryViewModel>
@{ ViewData["Title"] = "Orders";  }
<div class="page-head">
    <h1>Orders</h1>
</div>

@if (TempData["Message"] is string message) { <div class="alert alert-info" role="status">@message</div> }

<div class="section-card">
@if (Model.Count == 0)
{
    <div class="empty-state">No orders yet.</div>
}
else
{
    <div class="table-responsive"><table class="admin-table">
        <thead><tr><th>Order</th><th>Concert</th><th>Customer</th><th>Status</th><th>Total</th><th>Placed</th><th></th></tr></thead>
        <tbody>
        @foreach (var o in Model)
        {
            <tr>
                <td>#@o.Id</td>
                <td>@o.ConcertTitle</td>
                <td>@o.UserName<br /><small class="text-white-50">@o.UserEmail</small></td>
                <td>
                    @{ var nextStatuses = OnlineConcertTicketingReservationSystem.Services.OrderStatusChanges.Allowed(o.Status); }
                    @if (nextStatuses.Length > 0)
                    {
                        <form asp-action="UpdateStatus" method="post" class="d-flex gap-2 align-items-center">
                            <input type="hidden" name="orderId" value="@o.Id" />
                            <input type="hidden" name="expectedStatus" value="@o.Status" />
                            <select name="status" class="form-select form-select-sm" style="min-width:160px" aria-label="Status for order @o.Id">
                                <option value="@o.Status">@OnlineConcertTicketingReservationSystem.Services.OrderStatusChanges.Label(o.Status)</option>
                                @foreach (var status in nextStatuses) { <option value="@status">@OnlineConcertTicketingReservationSystem.Services.OrderStatusChanges.Label(status)</option> }
                            </select>
                            <button class="btn btn-sm btn-outline-light">Save</button>
                        </form>
                    }
                    else { <span class="status-pill status-@o.Status">@OnlineConcertTicketingReservationSystem.Services.OrderStatusChanges.Label(o.Status)</span> }
                </td>
                <td>MMK @o.TotalAmount.ToString("N2")</td>
                <td>@o.CreatedAt.ToLocalTime().ToString("g")</td>
                <td><a asp-action="OrderDetail" asp-route-id="@o.Id" class="order-view" data-order-id="@o.Id">View</a></td>
            </tr>
        }
        </tbody>
    </table></div>
}
</div>

<partial name="_OrderModal" />
@section Scripts { <script src="~/js/order-details.js" asp-append-version="true"></script> }
