@model OnlineConcertTicketingReservationSystem.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="page-head"><h1>Checkout</h1></div>
<p class="text-white-50 mt-n3 mb-4">@Model.ConcertTitle</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="section-card">
            <h4>Order summary</h4>
            <ul class="list-group mb-3">
                @foreach (var ticket in Model.TicketSummaries)
                {
                    <li class="list-group-item">@ticket</li>
                }
                @foreach (var accessory in Model.AccessorySummaries)
                {
                    <li class="list-group-item">@accessory</li>
                }
                <li class="list-group-item fw-bold">Total: MMK @Model.TotalAmount</li>
            </ul>

        </div>
    </div>

    <div class="col-md-6">
        <div class="section-card">
            <h4>Payment</h4>
            <p class="text-white-50">Continue to the local mock payment gateway. A successful payment confirms the booking immediately.</p>
            @if (Model.CanPay)
            {
            <a asp-controller="MockPayment" asp-action="Pay" asp-route-orderId="@Model.OrderId" class="btn btn-primary w-100">Continue to payment</a>
            }
            else { <p class="alert alert-warning">This older reservation has expired.</p> }
            <a asp-action="SelectTickets" asp-route-concertId="@Model.ConcertId" class="btn btn-outline-light w-100 mt-2">Change tickets</a>
        </div>
    </div>
</div>
