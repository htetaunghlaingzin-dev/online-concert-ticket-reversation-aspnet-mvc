@model OnlineConcertTicketingReservationSystem.Models.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Checkout";
}

<div class="page-head"><h1>Checkout</h1></div>
<p class="text-white-50 mt-n3 mb-4">@Model.ConcertTitle</p>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="section-card">
            <h4>Order summary</h4>
            <ul class="list-group mb-3">
                @foreach (var seat in Model.SeatSummaries)
                {
                    <li class="list-group-item">@seat</li>
                }
                @foreach (var accessory in Model.AccessorySummaries)
                {
                    <li class="list-group-item">@accessory</li>
                }
                <li class="list-group-item fw-bold">Total: $@Model.TotalAmount</li>
            </ul>

            <div class="alert alert-warning mb-0">
                Time remaining to complete payment: <span id="countdown" class="fw-bold"></span>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="section-card">
            <h4>Payment</h4>
            <p class="text-white-50">Continue to the local mock payment gateway. A successful payment confirms the booking immediately.</p>
            <a asp-controller="MockPayment" asp-action="Pay" asp-route-orderId="@Model.OrderId" class="btn btn-primary w-100">Continue to payment</a>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const lockExpiresAt = @(Model.LockExpiresAt.HasValue ? $"new Date('{Model.LockExpiresAt.Value:O}')" : "null");
        const countdownEl = document.getElementById("countdown");

        function updateCountdown() {
            if (!lockExpiresAt) {
                countdownEl.textContent = "N/A";
                return;
            }
            const remainingMs = lockExpiresAt - new Date();
            if (remainingMs <= 0) {
                countdownEl.textContent = "Expired";
                return;
            }
            const minutes = Math.floor(remainingMs / 60000);
            const seconds = Math.floor((remainingMs % 60000) / 1000);
            countdownEl.textContent = `${minutes}:${seconds.toString().padStart(2, "0")}`;
        }

        updateCountdown();
        setInterval(updateCountdown, 1000);
    </script>
}
