@model IEnumerable<OnlineConcertTicketingReservationSystem.Models.Ticket>
@{ ViewData["Title"] = "My Tickets"; }
<div class="page-head"><h1>My Tickets</h1></div>
@if (!Model.Any())
{
    <div class="section-card empty-state">You haven't booked any tickets yet.</div>
}
<div class="row row-cols-1 row-cols-md-2 g-3">
@foreach (var ticket in Model)
{
    var revoked = ticket.RevokedAt is not null;
    <div class="col"><div class="section-card mb-0 d-flex justify-content-between align-items-center @(revoked ? "opacity-75" : "")">
        <div>
            <h5 class="mb-1">@ticket.Order.Concert.Title</h5>
            <p class="mb-1 text-white-50">@ticket.DisplayType · MMK @ticket.DisplayPrice.ToString("N2")</p>
            <code>@ticket.TicketCode</code>
            @if (revoked)
            {
                <div class="mt-2"><span class="status-pill status-Cancelled">Cancelled</span>
                @if (!string.IsNullOrEmpty(ticket.Order.CancellationReason))
                {
                    <p class="text-white-50 small mt-1 mb-0">@ticket.Order.CancellationReason</p>
                }
                </div>
            }
        </div>
        @if (!revoked)
        {
            <img width="110" height="110" src="@Url.Action("Qr", new { id = ticket.Id })" alt="Ticket QR code" class="rounded" />
        }
    </div></div>
}
</div>
