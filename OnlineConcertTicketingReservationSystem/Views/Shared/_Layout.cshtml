<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - OnlineConcertTicketingReservationSystem</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/OnlineConcertTicketingReservationSystem.styles.css" asp-append-version="true"/>
</head>
<body>
<header>
    <nav class="navbar navbar-expand-sm navbar-toggleable-sm site-nav">
        <div class="container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index"><span class="brand-mark">◉</span>LIVEWIRE</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Discover</a>
                    </li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Concerts</a></li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item"><a class="nav-link text-dark" asp-controller="Ticket" asp-action="MyTickets">My Tickets</a></li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Admin</a>
                            <ul class="dropdown-menu">
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Dashboard">Dashboard</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="Orders">Orders</a></li>
                                <li><a class="dropdown-item" asp-controller="Admin" asp-action="VerificationQueue">Verification Queue</a></li>
                                <li><a class="dropdown-item" asp-controller="Ticket" asp-action="Validate">Validate Ticket</a></li>
                                <li><hr class="dropdown-divider" /></li>
                                <li><a class="dropdown-item" asp-controller="Management" asp-action="Index">Manage Catalog</a></li>
                            </ul>
                        </li>
                    }
                </ul>
                <partial name="_LoginPartial"/>
            </div>
        </div>
    </nav>
</header>
<div class="container page-shell">
    @{ var adminPage = User.IsInRole("Admin") && (ViewContext.RouteData.Values["controller"]?.ToString() is "Admin" or "Management" || (ViewContext.RouteData.Values["controller"]?.ToString() == "Ticket" && ViewContext.RouteData.Values["action"]?.ToString() == "Validate")); }
    <div class="@(adminPage ? "admin-shell" : "")">
        @if (adminPage)
        {
            <aside class="admin-sidebar" aria-label="Admin sidebar">
                <div class="eyebrow mb-3">Administration</div>
                <a asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                <a asp-controller="Admin" asp-action="Orders">Orders</a>
                <a asp-controller="Admin" asp-action="VerificationQueue">Payment verification</a>
                <a asp-controller="Ticket" asp-action="Validate">Validate ticket</a>
                <div class="eyebrow mt-4 mb-2">Create and edit</div>
                <a asp-controller="Management" asp-action="CreateVenue" asp-fragment="tab-catalog">Create a Venue</a>
                <a asp-controller="Management" asp-action="Index" asp-fragment="tab-concerts">Concerts and schedules</a>
                <a asp-controller="Management" asp-action="Index" asp-fragment="tab-ticketing">Ticket types and stock</a>
                <a asp-controller="Management" asp-action="Index" asp-fragment="tab-catalog">Artists</a>
                <a asp-controller="Management" asp-action="Index" asp-fragment="tab-merch">Merchandise</a>
            </aside>
        }
        <main role="main" class="pb-3 admin-content">@RenderBody()</main>
    </div>
</div>

<footer class="border-top site-footer">
    <div class="container">
        &copy; 2026 LIVEWIRE · Concerts made simple
    </div>
</footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
