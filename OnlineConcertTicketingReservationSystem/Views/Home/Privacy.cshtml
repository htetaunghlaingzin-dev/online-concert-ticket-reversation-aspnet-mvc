@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="page-head"><h1>@ViewData["Title"]</h1></div>
<div class="section-card">
    <p>This is a demo ticketing platform. Payments are processed through a local mock gateway — no real card or bank data is ever collected.</p>
