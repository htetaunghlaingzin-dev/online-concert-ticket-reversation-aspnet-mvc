@model OnlineConcertTicketingReservationSystem.Models.ViewModels.SeatSelectionViewModel
@{ ViewData["Title"] = "Choose seats"; }
<div class="booking-head"><div class="eyebrow">Choose your experience</div><h1>@Model.ConcertTitle</h1><p class="mb-0 text-white-50">@Model.EventDate.ToLocalTime().ToString("dddd, MMMM d · h:mm tt")</p></div>
@if (!string.IsNullOrEmpty(Model.ErrorMessage)){<div class="alert alert-danger">@Model.ErrorMessage</div>}
<div class="row g-4"><div class="col-lg-8"><section class="seat-panel"><div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2"><h3 class="mb-0">Seat map</h3><div class="legend"><span><i class="legend-dot" style="background:#bef264"></i>Available</span><span><i class="legend-dot" style="background:#fbbf24"></i>Held</span><span><i class="legend-dot" style="background:#4a5068"></i>Sold</span></div></div>
@if (Model.TicketTypeLegend.Count > 0)
{
    var tierColors = new[] { "#fbbf24", "#60a5fa", "#f472b6" };
    <div class="tier-legend mb-3">@for (var i = 0; i < Model.TicketTypeLegend.Count; i++) { var t = Model.TicketTypeLegend[i]; <span><i class="tier-swatch" style="background:@(i < tierColors.Length ? tierColors[i] : "#a8adc2")"></i>@t.Name · $@t.Price</span> }</div>
}
<div class="seat-stage">STAGE</div><div class="seat-scroll"><div id="seat-grid" class="seat-grid" data-concert-id="@Model.ConcertId">
@{
    var tierRank = Model.TicketTypeLegend.Select((t, i) => new { t.Name, Rank = i }).ToDictionary(x => x.Name, x => x.Rank);
}
@foreach(var sectionGroup in Model.Seats.GroupBy(s=>s.Section)){<div class="mb-3"><div class="eyebrow mb-2">Section @sectionGroup.Key</div>@foreach(var row in sectionGroup.GroupBy(s=>s.Row)){<div class="seat-row"><span class="seat-row-label">ROW @row.Key</span>@foreach(var seat in row.OrderBy(s=>s.SeatNumber)){var css=seat.Status.ToString() switch{"Available"=>"seat-available","PendingPayment"=>"seat-pending","Booked"=>"seat-booked",_=>"seat-available"};var rank=seat.TicketTypeName is not null && tierRank.ContainsKey(seat.TicketTypeName) ? tierRank[seat.TicketTypeName] : (int?)null;<div class="seat-cell @css @(Model.ConflictingSeatIds.Contains(seat.Id) ? "seat-selected":"")" data-seat-id="@seat.Id" data-status="@seat.Status" data-tier-rank="@(rank?.ToString())" title="Section @seat.Section, Row @seat.Row, Seat @seat.SeatNumber · $@seat.Price@(seat.TicketTypeName is not null ? $" · {seat.TicketTypeName}" : "")">@seat.SeatNumber</div>}</div>}</div>}</div></div></section></div>
<div class="col-lg-4"><aside class="summary-panel"><div class="eyebrow">Your selection</div><h3>Make it yours</h3><form asp-action="ReserveSeats" method="post" id="reserve-form"><input type="hidden" name="ConcertId" value="@Model.ConcertId"/><div id="selected-seat-inputs"></div><div class="d-flex justify-content-between border-bottom pb-3 mb-3"><span class="text-white-50">Selected seats</span><strong id="selected-count">0</strong></div>@if (Model.Accessories.Count > 0)
{
    <h6 class="mt-4">Extras</h6>
    <div class="extras-grid">
    @for (var i = 0; i < Model.Accessories.Count; i++)
    {
        var a = Model.Accessories[i];
        <div class="extra-card">
            <input type="hidden" name="Accessories[@i].AccessoryId" value="@a.Id"/>
            @if (!string.IsNullOrEmpty(a.ImageUrl))
            {
                <img class="extra-photo" src="@a.ImageUrl" alt="@a.Name" loading="lazy" onerror="this.replaceWith(Object.assign(document.createElement('div'),{className:'extra-photo extra-photo-placeholder',textContent:'@a.Name.Substring(0,1).ToUpper()'}))"/>
            }
            else
            {
                <div class="extra-photo extra-photo-placeholder">@a.Name.Substring(0, 1).ToUpper()</div>
            }
            <div class="extra-body">
                <p class="extra-name mb-0">@a.Name</p>
                <p class="extra-price mb-2">$@a.Price.ToString("N2") @(a.StockQuantity <= 0 ? "· sold out" : "")</p>
                <input type="number" name="Accessories[@i].Quantity" class="form-control form-control-sm" min="0" max="@a.StockQuantity" value="0" disabled="@(a.StockQuantity <= 0)"/>
            </div>
        </div>
    }
    </div>
}
<button type="submit" class="btn btn-primary w-100 mt-4">Reserve tickets</button><p class="small text-white-50 text-center mt-3 mb-0">Seats are held for 10 minutes at checkout.</p></form></aside></div></div>
@section Scripts {<script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js" crossorigin="anonymous"></script><script src="~/js/seat-hub.js"></script>}
